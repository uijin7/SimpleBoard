$env:DB_URL = "jdbc:postgresql://<host>:5432/<database>?sslmode=require"
$env:DB_USERNAME = "<username>"
$env:DB_PASSWORD = "<password>"
$env:JPA_DIALECT = "org.hibernate.dialect.PostgreSQLDialect"
$env:SPRING_PROFILES_ACTIVE = "local"

# Optional overrides
# $env:SERVER_PORT = "8082"
# $env:LOCAL_DB_URL = $env:DB_URL
# $env:LOCAL_DB_USERNAME = $env:DB_USERNAME
# $env:LOCAL_DB_PASSWORD = $env:DB_PASSWORD
